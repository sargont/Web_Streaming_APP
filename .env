# =========================
# APP CONFIG
# =========================
NODE_ENV=development
PORT=8787
APP_NAME=COMMUNICATION_GATEWAY

# =========================
# INFOBIP CONFIG
# =========================
INFOBIP_BASE_URL=https://w11lv8.api.infobip.com
INFOBIP_API_KEY=PASTE_REAL_KEY_HERE

# =========================
# SMS CONFIG
# =========================
INFOBIP_SMS_SENDER=VodacomLS

# =========================
# WEBHOOKS
# =========================
INFOBIP_WEBHOOK_URL=http://localhost:8787/webhooks/infobip
INFOBIP_WEBHOOK_SECRET=your_secure_secret

# =========================
# SECURITY
# =========================
JWT_SECRET=your_jwt_secret
SESSION_SECRET=your_session_secret

# =========================
# LOGGING
# =========================
LOG_PATH=./logs
ENABLE_DELIVERY_REPORTS=true
